# Copy this file to .env and fill in real values. .env is gitignored.

# Groq API key — used for:
#   - config-time synonym expansion (one call per schema column, on save)
#   - candidate verification/rerank (Llama 3.3 70B) during a run
GROQ_API_KEY=

# Optional: path to the Tesseract OCR binary, if it is not on PATH.
# Windows default install location (UB-Mannheim build):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
