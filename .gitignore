# --- Secrets ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments (conda env itself lives outside the repo, but guard anyway) ---
.venv/
venv/
env/

# --- SQLite / app config DB ---
*.db
*.sqlite
*.sqlite3
db/*.db
db/*.sqlite
db/*.sqlite3

# --- Downloaded OCR model weights ---
# PaddleOCR/PaddleX cache models under the user's home dir by default
# (~/.paddlex/official_models), but guard any project-local model dirs too.
*.pdiparams
*.pdiparams.info
*.pdmodel
*.onnx
models/
.paddlex/
paddleocr_models/
tesseract_data/

# --- Uploaded tender documents / session temp files ---
# Company PDFs/zips are session-scoped and must never be committed.
uploads/
tmp_uploads/
*.pdf
*.zip
data/companies/
session_data/

# --- Streamlit ---
.streamlit/secrets.toml

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.log
.vscode/*
!.vscode/extensions.json

# --- Claude Code local session/tooling state (not part of the project) ---
.claude/
CHECKLIST.md