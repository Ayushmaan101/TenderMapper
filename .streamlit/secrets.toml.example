# Streamlit's native secrets store (checklist 5.2).
#
# Local dev does NOT need this file — .env + python-dotenv (see
# .env.example) is this project's local dev convention and keeps working
# unchanged. This file only matters for Streamlit Community Cloud, which
# has no .env file at all: paste these same key/value pairs into the app's
# "Settings -> Secrets" panel in the Community Cloud dashboard, and
# app.py's startup bootstrap bridges them into os.environ automatically.
#
# If you do want to test the st.secrets path locally, copy this file to
# .streamlit/secrets.toml and fill in a real value.
# .streamlit/secrets.toml itself is gitignored — never commit real secrets.

GROQ_API_KEY = "your-groq-api-key-here"
